<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Permiso de sistema que NO se puede conceder desde la app ni desde un dialogo: solo por
        adb, a proposito. Se declara para permitir una unica cosa: devolver los gestos de
        navegacion cuando MIUI los apaga por tener un launcher externo como predeterminado.

        Sin conceder, la app funciona igual; la proteccion de gestos queda deshabilitada y se
        muestra el comando exacto en Ajustes. Ver GuardianDeGestos.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Red de seguridad para listar aplicaciones.
        Los launchers (intent-filter HOME) estan exentos del filtrado de visibilidad de paquetes
        de Android 11+, asi que NO se declara QUERY_ALL_PACKAGES. Este bloque <queries> cubre el
        caso de estar instalado pero todavia no ser el launcher predeterminado.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!--
            Sin estas dos entradas, tocar la hora o la fecha no abre nada mientras la app
            todavia no es el launcher predeterminado: el filtrado de visibilidad de Android 11+
            impide resolver estos intents y startActivity falla en silencio.
        -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <!--
            Relojes y calendarios de fabricantes que no declaran las acciones estandar.
            MIUI, por ejemplo, no atiende SHOW_ALARMS: hay que abrir su app directamente.
        -->
        <package android:name="com.android.deskclock" />
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.sec.android.app.clockpackage" />
        <package android:name="com.android.calendar" />
        <package android:name="com.google.android.calendar" />
        <package android:name="com.xiaomi.calendar" />
    </queries>

    <!--
        Permiso normal (no requiere confirmacion del usuario) para el gesto de deslizar
        hacia abajo. Si el fabricante lo bloquea, la funcion simplemente no hace nada.
    -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <application
        android:name=".SyncroLauncherApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/reglas_extraccion_datos"
        android:fullBackupContent="@xml/reglas_respaldo"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/nombre_app"
        android:supportsRtl="true"
        android:theme="@style/Theme.SyncroLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="nosensor"
            android:configChanges="keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SyncroLauncher">

            <!-- HOME + DEFAULT: esto es lo que convierte la app en un launcher elegible. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Gestos de navegacion propios, para los telefonos donde el sistema los desactiva al
            usar un launcher externo (MIUI y capas similares). Queda inactivo mientras el usuario
            no lo habilite en los ajustes de accesibilidad; la app funciona igual sin el.
        -->
        <service
            android:name=".gestos.ServicioGestosBorde"
            android:exported="true"
            android:label="@string/nombre_servicio_gestos"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/servicio_gestos" />
        </service>
    </application>

</manifest>
